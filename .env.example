# Copy this file to .env and fill in your values.

# The target person's phone number to watch (no leading 0, include country code)
TARGET_SENDER_NUMBER=your_target_number_here

# The target group chat ID to watch (ends in @g.us)
TARGET_GROUP_ID=your_group_id_here

# Log level: trace | debug | info | warn | error | fatal
# Use "debug" locally to see all incoming messages, "info" on the server
LOG_LEVEL=debug

# "development" locally (pretty colored logs), "production" on the server (JSON logs)
NODE_ENV=development

# The message the bot replies when a rule matches
CHAT_RESPONSE=your_response_here

# Max number of times the bot replies normally to a sender within the time window
RATE_LIMIT_MAX=5

# Time window in milliseconds - 3600000 = 1 hour
RATE_LIMIT_WINDOW_MS=3600000

# Message sent exactly once when a sender exceeds the limit
RATE_LIMIT_MESSAGE=חחחח